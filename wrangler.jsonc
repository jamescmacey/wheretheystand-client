{
	"name": "wheretheystand-client",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-06-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".output/public",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "wheretheystand.nz",
			"custom_domain": true,
            "enabled":true
		},
        {
            "pattern": "beta.wheretheystand.nz",
            "custom_domain": true,
            "previews_enabled": true,
            "enabled": true
        }
	],
	"build": {
		"command": "npm run build"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wheretheystand-client",
			"database_id": "bf34562c-3d80-4550-8e83-904a56936609"
		}
	],
	"observability": {
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"previews": {
		"observability": {
			"enabled": true,
			"head_sampling_rate": 1,
			"issues": {
				"enabled": true
			},
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true,
				"persist": true
			},
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1,
				"persist": true
			}
		}
	},
    "preview_urls": true
}