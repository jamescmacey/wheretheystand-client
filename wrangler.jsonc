{
	"name": "wheretheystand-client",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-06-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".output/public",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "wheretheystand.nz",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"build": {
		"command": "npm run build"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wheretheystand-client",
			"database_id": "bf34562c-3d80-4550-8e83-904a56936609"
		}
	],
	"observability": {
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"previews": {
		"observability": {
			"enabled": true,
			"head_sampling_rate": 1,
			"issues": {
				"enabled": true
			},
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true,
				"persist": true
			},
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1,
				"persist": true
			}
		},
		"vars": {
			"NUXT_PUBLIC_API_BASE": "https://api.wheretheystand.nz/v2/",
			"NUXT_PUBLIC_API_ORIGIN": "https://api.wheretheystand.nz",
			"NUXT_PUBLIC_BANNERS_API_BASE": "https://banners.wheretheystand.nz/",
			"NUXT_PUBLIC_SITE_URL": "https://wheretheystand.nz",
			"NUXT_PUBLIC_ALGOLIA_INDEX_PREFIX": "wts_v2",
			"NUXT_PUBLIC_ALGOLIA_INDEX_SUFFIX": "prod",
			"NUXT_PUBLIC_ELECTIONS_ENABLED": "true",
			"NUXT_PUBLIC_ELECTIONS_BYPASS_COUNTDOWN": "true",
			"NUXT_PUBLIC_ELECTIONS_DEBUG": "true",
			"NUXT_PUBLIC_ELECTIONS_WHATIF_ENABLED": "true",
			"NUXT_PUBLIC_ELECTIONS_SNAPSHOT_BASE": "https://elections-r2.wheretheystand.nz/",
			"NUXT_PUBLIC_SHOW_ELECTORAL_HISTORY": "false",
			"NUXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyBa0-MizvI5365_ln6C7ciSeQmsJhgwCjM",
			"NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "wheretheystand-elections.firebaseapp.com",
